# Database
# If using Docker Compose (recommended for local development):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/globetrotter"
# If using your own PostgreSQL instance:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/globetrotter"

# Authentication
AUTH_SECRET="your-secret-key-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Optional External APIs
MAPS_API_KEY=
TRAVEL_API_KEY=
AI_API_KEY=
